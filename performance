def generate_charts(baseline: dict, post: dict, delta: dict, output_dir: str) -> list[str]:
    """Generate performance comparison charts; returns list of file paths."""
    if not HAS_PLOTLY:
        print("  [WARN] plotly not installed — skipping charts.")
        return []

    charts = []
    os.makedirs(output_dir, exist_ok=True)

    # ── 1. Node CPU before vs after ──────────────────────────────────────────
    nodes = delta.get("nodes", [])
    if nodes:
        names = [n["name"] for n in nodes]
        cpu_base = [n["cpu_base"] for n in nodes]
        cpu_post = [n["cpu_post"] for n in nodes]

        fig = go.Figure()
        fig.add_trace(go.Bar(name="Baseline", x=names, y=cpu_base))
        fig.add_trace(go.Bar(name="Post-Deploy", x=names, y=cpu_post))
        fig.update_layout(
            title={"text": "Node CPU Usage: Baseline vs Post-Deploy<br>"
                           "<span style='font-size:14px;font-weight:normal;'>"
                           "CPU cores used per node</span>"},
            barmode="group",
            legend=dict(orientation="h", yanchor="bottom", y=1.05, xanchor="center", x=0.5),
        )
        fig.update_xaxes(title_text="Node")
        fig.update_yaxes(title_text="CPU (cores)")
        path = os.path.join(output_dir, "chart_node_cpu.png")
        fig.write_image(path)
        charts.append(path)

    # ── 2. Node Memory before vs after ───────────────────────────────────────
    if nodes:
        mem_base = [n["mem_base"] for n in nodes]
        mem_post = [n["mem_post"] for n in nodes]

        fig = go.Figure()
        fig.add_trace(go.Bar(name="Baseline", x=names, y=mem_base))
        fig.add_trace(go.Bar(name="Post-Deploy", x=names, y=mem_post))
        fig.update_layout(
            title={"text": "Node Memory Usage: Baseline vs Post-Deploy<br>"
                           "<span style='font-size:14px;font-weight:normal;'>"
                           "MiB used per node</span>"},
            barmode="group",
            legend=dict(orientation="h", yanchor="bottom", y=1.05, xanchor="center", x=0.5),
        )
        fig.update_xaxes(title_text="Node")
        fig.update_yaxes(title_text="Memory (MiB)")
        path = os.path.join(output_dir, "chart_node_mem.png")
        fig.write_image(path)
        charts.append(path)

    # ── 3. Falcon pods resource breakdown ────────────────────────────────────
    falcon_pods = post.get("falcon_pods", [])
    if falcon_pods:
        pod_names = [p["pod"][:30] for p in falcon_pods]
        pod_cpu   = [p["cpu_cores"] for p in falcon_pods]
        pod_mem   = [p["mem_mib"]   for p in falcon_pods]

        fig = make_subplots(rows=1, cols=2,
                            subplot_titles=("CPU (cores)", "Memory (MiB)"))
        fig.add_trace(go.Bar(x=pod_names, y=pod_cpu, name="CPU"), row=1, col=1)
        fig.add_trace(go.Bar(x=pod_names, y=pod_mem, name="Memory"), row=1, col=2)
        fig.update_layout(
            title={"text": "Falcon Pod Resource Usage (Post-Deploy)<br>"
                           "<span style='font-size:14px;font-weight:normal;'>"
                           "Per-pod CPU and memory</span>"},
            showlegend=False,
        )
        path = os.path.join(output_dir, "chart_falcon_pods.png")
        fig.write_image(path)
        charts.append(path)

    # ── 4. Admission webhook latency ─────────────────────────────────────────
    lat = post.get("admission_latency", {})
    lat_vals = {k: v for k, v in lat.items()
                if k in ("p50", "p95", "p99") and v is not None}
    if lat_vals:
        fig = go.Figure(go.Bar(
            x=list(lat_vals.keys()),
            y=list(lat_vals.values()),
            text=[f"{v} ms" for v in lat_vals.values()],
            textposition="outside",
        ))
        fig.update_layout(
            title={"text": "KAC Admission Webhook Latency (Post-Deploy)<br>"
                           "<span style='font-size:14px;font-weight:normal;'>"
                           "p50 / p95 / p99 in milliseconds</span>"},
        )
        fig.update_xaxes(title_text="Percentile")
        fig.update_yaxes(title_text="Latency (ms)")
        path = os.path.join(output_dir, "chart_webhook_latency.png")
        fig.write_image(path)
        charts.append(path)

    return charts


